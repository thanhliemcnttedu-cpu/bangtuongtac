# Sao chép tệp này thành .env rồi điền giá trị thật (Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://<ma-du-an-supabase>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>
# Tùy chọn: khóa CÔNG KHAI VAPID để bật nhắc việc đẩy (tạo bằng: npx web-push generate-vapid-keys). Xem docs/HUONG-DAN-NHAC-VIEC-DAY.md
VITE_VAPID_PUBLIC_KEY=
